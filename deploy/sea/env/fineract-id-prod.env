# =============================================================================
# Indonesia Production Environment
# Currency: IDR (Indonesian Rupiah) - 0 decimal places
# Timezone: Asia/Jakarta (UTC+7)
# Regulator: OJK (Financial Services Authority)
# =============================================================================

# ---- Tenant Configuration ----
FINERACT_DEFAULT_TENANTDB_TIMEZONE=Asia/Jakarta
FINERACT_DEFAULT_TENANTDB_IDENTIFIER=indonesia
FINERACT_DEFAULT_TENANTDB_NAME=fineract_indonesia
FINERACT_DEFAULT_TENANTDB_DESCRIPTION=Indonesia Digital Banking

# ---- Currency ----
# IDR - Indonesian Rupiah (0 decimal places - MUST be set correctly)
FINERACT_CONFIG_ROUNDING_MODE=0

# ---- Payment Gateways ----
# BI-Fast (Bank Indonesia National Transfer)
BIFAST_ENABLED=true
BIFAST_GATEWAY_URL=https://api.bi.go.id/bifast
BIFAST_BANK_CODE=CHANGEME_BANK_CODE
BIFAST_CORP_ID=CHANGEME_CORP_ID
BIFAST_SIGNING_KEY=CHANGEME_BIFAST_KEY

# QRIS (QR Indonesia Standard)
QRIS_ENABLED=true
QRIS_GATEWAY_URL=https://api.qris.id/v1
QRIS_NATIONAL_MERCHANT_ID=CHANGEME_NMID
QRIS_SIGNING_KEY=CHANGEME_QRIS_KEY
QRIS_NOTIFY_URL=https://api.your-domain.com/api/v1/payments/qris/callback

# Gojek Pay (GoTo Financial)
GOJEKPAY_ENABLED=true
GOJEKPAY_GATEWAY_URL=https://api.gojek.com/gopay/v1
GOJEKPAY_CLIENT_ID=CHANGEME_GOJEK_CLIENT_ID
GOJEKPAY_CLIENT_SECRET=CHANGEME_GOJEK_SECRET
GOJEKPAY_NOTIFY_URL=https://api.your-domain.com/api/v1/payments/gojek/callback

# OVO
OVO_ENABLED=true
OVO_GATEWAY_URL=https://api.ovo.id/payment/v1
OVO_PARTNER_CODE=CHANGEME_OVO_PARTNER_CODE
OVO_SECRET_KEY=CHANGEME_OVO_SECRET

# ShopeePay
SHOPEEPAY_ENABLED=false
SHOPEEPAY_GATEWAY_URL=https://api.shopeepay.co.id/v2
SHOPEEPAY_CLIENT_ID=CHANGEME_SHOPEE_CLIENT_ID
SHOPEEPAY_CLIENT_SECRET=CHANGEME_SHOPEE_SECRET

# Dana
DANA_ENABLED=false
DANA_GATEWAY_URL=https://api.dana.id/
DANA_CLIENT_ID=CHANGEME_DANA_CLIENT_ID
DANA_CLIENT_SECRET=CHANGEME_DANA_SECRET

# Virtual Account (VA) for Major Banks
BANK_VA_ENABLED=true
# BCA, BNI, BRI, Mandiri, CIMB Niaga, Danamon, etc.
BANK_VA_BCA_ENABLED=true
BANK_VA_BNI_ENABLED=true
BANK_VA_BRI_ENABLED=true
BANK_VA_MANDIRI_ENABLED=true

# ---- SMS Gateway (Indonesia) ----
SMS_GATEWAY_ENABLED=true
SMS_GATEWAY_URL=https://api.sms-gateway.id/send
SMS_GATEWAY_API_KEY=CHANGEME_SMS_API_KEY
SMS_SENDER_ID=YOURBRND

# ---- Email Configuration ----
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@mg.your-domain.com
SMTP_PASSWORD=CHANGEME_SMTP_PASSWORD
SMTP_FROM=noreply@your-domain.com

# ---- Tax Configuration ----
# Indonesia VAT: 11%
FINERACT_TAX_VAT_RATE=11
FINERACT_TAX_VAT_ENABLED=true

# ---- Regulatory Reporting ----
OJK_REPORTING_ENABLED=true
OJK_REPORTING_FREQUENCY=MONTHLY
OJK_REPORTING_LICENSE_NO=CHANGEME_OJK_LICENSE

# ---- ID Types (Indonesia) ----
# KTP (Identity Card), Passport, SIM (Driver License), NPWP (Tax ID)
FINERACT_ID_TYPES=KTP,PASSPORT,SIM,NPWP

# ---- Phone Number Format ----
# Indonesia: +62 XXX XXXX XXXX
FINERACT_PHONE_REGEX=^\+62[0-9]{11,13}$

# ---- Local Language ----
FINERACT_DEFAULT_LANGUAGE=id_ID
FINERACT_SUPPORTED_LANGUAGES=id_ID,en_US
