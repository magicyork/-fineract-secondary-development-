# =============================================================================
# Philippines Production Environment
# Currency: PHP (Philippine Peso)
# Timezone: Asia/Manila (UTC+8)
# Regulator: BSP
# =============================================================================

# ---- Tenant Configuration ----
FINERACT_DEFAULT_TENANTDB_TIMEZONE=Asia/Manila
FINERACT_DEFAULT_TENANTDB_IDENTIFIER=philippines
FINERACT_DEFAULT_TENANTDB_NAME=fineract_philippines
FINERACT_DEFAULT_TENANTDB_DESCRIPTION=Philippines Digital Banking

# ---- Currency ----
# PHP - Philippine Peso (2 decimal places)
FINERACT_CONFIG_ROUNDING_MODE=2

# ---- Payment Gateways ----
# GCash (Globe Telecom / Alipay)
GCASH_ENABLED=true
GCASH_GATEWAY_URL=https://api.gcash.com/merchant/v1
GCASH_PARTNER_ID=CHANGEME_GCASH_PARTNER_ID
GCASH_SSO_KEY=CHANGEME_GCASH_SSO_KEY
GCASH_NOTIFY_URL=https://api.your-domain.com/api/v1/payments/gcash/callback
GCASH_TIMEOUT=30

# Maya (formerly PayMaya / PLDT)
MAYA_ENABLED=true
MAYA_GATEWAY_URL=https://api.paymaya.com/paymayav2
MAYA_PUBLIC_KEY=CHANGEME_MAYA_PUBLIC_KEY
MAYA_PRIVATE_KEY=CHANGEME_MAYA_PRIVATE_KEY
MAYA_NOTIFY_URL=https://api.your-domain.com/api/v1/payments/maya/callback

# PESONet (BSP National Electronic Fund Transfer)
PESONET_ENABLED=true
PESONET_GATEWAY_URL=https://api.bsp.gov.ph/pesonet
PESONET_BANK_CODE=CHANGEME_BANK_CODE
PESONET_BRANCH_CODE=CHANGEME_BRANCH_CODE

# Coins.ph
COINSPH_ENABLED=false
COINSPH_GATEWAY_URL=https://api.coins.ph/v1
COINSPH_API_KEY=CHANGEME_COINSPH_API_KEY

# UnionPay International
UNIONPAY_ENABLED=true
UNIONPAY_GATEWAY_URL=https://gateway.unionpay.com/upapi/pay
UNIONPAY_MERCHANT_ID=CHANGEME_UP_MERCHANT_ID
UNIONPAY_SECRET_KEY=CHANGEME_UP_SECRET_KEY

# Credit Cards (Visa/Mastercard via Acquiring Bank)
CREDIT_CARD_ENABLED=true
CREDIT_CARD_GATEWAY_URL=CHANGEME_ACQUIRER_URL
CREDIT_CARD_MERCHANT_ID=CHANGEME_ACQUIRER_MERCHANT_ID

# ---- SMS Gateway (Philippines) ----
# Recommended: Globe API, Smart Communications API, or SMS Gateway aggregator
SMS_GATEWAY_ENABLED=true
SMS_GATEWAY_URL=https://api.sms-gateway.ph/send
SMS_GATEWAY_API_KEY=CHANGEME_SMS_API_KEY
SMS_SENDER_ID=YOUR_BRAND

# ---- Email Configuration ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@your-domain.com
SMTP_PASSWORD=CHANGEME_SMTP_PASSWORD
SMTP_FROM=noreply@your-domain.com

# ---- Tax Configuration ----
# Philippines VAT: 12%
FINERACT_TAX_VAT_RATE=12
FINERACT_TAX_VAT_ENABLED=true

# ---- Regulatory Reporting ----
BSP_REPORTING_ENABLED=true
BSP_REPORTING_FREQUENCY=MONTHLY
BSP_REPORTING_ENTITY_ID=CHANGEME_REPORTING_ID

# ---- ID Types (Philippines) ----
# SSS, GSIS, Voter ID, Passport, Driver's License, PRC ID
FINERACT_ID_TYPES=SSS,GSIS,VOTER_ID,PASSPORT,DRIVERS_LICENSE,PRC_ID,COMPANY_ID

# ---- Phone Number Format ----
# Philippines: +63 XXX XXX XXXX (Mobile) / +63 XX XXX XXXX (Landline)
FINERACT_PHONE_REGEX=^\+63[0-9]{10}$

# ---- Local Language ----
FINERACT_DEFAULT_LANGUAGE=en_PH
FINERACT_SUPPORTED_LANGUAGES=en_PH,fil_PH
