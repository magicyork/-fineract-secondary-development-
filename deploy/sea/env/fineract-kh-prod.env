# =============================================================================
# Cambodia Production Environment
# Currency: KHR (Cambodian Riel) - 0 decimal places
# Timezone: Asia/Phnom_Penh (UTC+7)
# Regulator: NBC (National Bank of Cambodia)
# =============================================================================

# ---- Tenant Configuration ----
FINERACT_DEFAULT_TENANTDB_TIMEZONE=Asia/Phnom_Penh
FINERACT_DEFAULT_TENANTDB_IDENTIFIER=cambodia
FINERACT_DEFAULT_TENANTDB_NAME=fineract_cambodia
FINERACT_DEFAULT_TENANTDB_DESCRIPTION=Cambodia Digital Banking

# ---- Currency ----
# KHR - Cambodian Riel (0 decimal places)
FINERACT_CONFIG_ROUNDING_MODE=0

# ---- Payment Gateways ----
# CIPS (Cambodian Interbank Payment System)
CIPS_ENABLED=true
CIPS_GATEWAY_URL=https://api.nbc.org.kh/cips
CIPS_BANK_CODE=CHANGEME_BANK_CODE
CIPS_MEMBER_ID=CHANGEME_MEMBER_ID

# Wing Money (Wing Bank)
WINGMONEY_ENABLED=true
WINGMONEY_GATEWAY_URL=https://api.wingmoney.com/v1
WINGMONEY_CLIENT_ID=CHANGEME_WING_CLIENT_ID
WINGMONEY_CLIENT_SECRET=CHANGEME_WING_SECRET
WINGMONEY_NOTIFY_URL=https://api.your-domain.com/api/v1/payments/wing/callback

# PiPay (Prince Bank / Cellcard)
PIPAY_ENABLED=true
PIPAY_GATEWAY_URL=https://api.pipay.com.kh/v1
PIPAY_MERCHANT_ID=CHANGEME_PIPAY_MERCHANT_ID
PIPAY_SECRET_KEY=CHANGEME_PIPAY_SECRET
PIPAY_NOTIFY_URL=https://api.your-domain.com/api/v1/payments/pipay/callback

# Bongloy (Electronic wallet)
BONGLOY_ENABLED=false
BONGLOY_GATEWAY_URL=https://api.bongloy.com/v2
BONGLOY_API_KEY=CHANGEME_BONGLOY_KEY

# Bank Transfers (Major Banks)
# ABA Bank, ACLEDA Bank, Cambodian Post Bank, Sathapana Bank, etc.
BANK_TRANSFER_ENABLED=true

# ---- SMS Gateway (Cambodia) ----
# Recommended: Cellcard, Smart, Metfone, or local SMS gateway
SMS_GATEWAY_ENABLED=true
SMS_GATEWAY_URL=https://api.sms-gateway.kh/send
SMS_GATEWAY_API_KEY=CHANGEME_SMS_API_KEY
SMS_SENDER_ID=YOUR_BRAND

# ---- Email Configuration ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@your-domain.com
SMTP_PASSWORD=CHANGEME_SMTP_PASSWORD
SMTP_FROM=noreply@your-domain.com

# ---- Tax Configuration ----
# Cambodia VAT: 10%
FINERACT_TAX_VAT_RATE=10
FINERACT_TAX_VAT_ENABLED=true

# ---- Regulatory Reporting ----
NBC_REPORTING_ENABLED=true
NBC_REPORTING_FREQUENCY=MONTHLY
NBC_REPORTING_LICENSE_NO=CHANGEME_NBC_LICENSE

# ---- ID Types (Cambodia) ----
# National ID Card, Passport, Driver License, Residence Booklet
FINERACT_ID_TYPES=NATIONAL_ID,PASSPORT,DRIVERS_LICENSE,RESIDENCE_BOOKLET

# ---- Phone Number Format ----
# Cambodia: +855 XX XXX XXX
FINERACT_PHONE_REGEX=^\+855[0-9]{8,9}$

# ---- Local Language ----
FINERACT_DEFAULT_LANGUAGE=km_KH
FINERACT_SUPPORTED_LANGUAGES=km_KH,en_US
