# =============================================================================
# Apache Fineract - Southeast Asia Common Environment
# Shared across all SEA deployments
# =============================================================================

# ---- Server Configuration ----
FINERACT_SERVER_PORT=8443
FINERACT_SERVER_SERVLET_CONTEXT_PATH=/fineract-provider
FINERACT_SERVER_SSL_ENABLED=true
FINERACT_SERVER_COMPRESSION_ENABLED=true

# ---- Database Connection Pool ----
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.postgresql.Driver
FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://db-primary:5432/fineract_tenants
FINERACT_HIKARI_USERNAME=fineract
FINERACT_HIKARI_PASSWORD=CHANGEME_USE_DOCKER_SECRETS
FINERACT_HIKARI_MINIMUM_IDLE=5
FINERACT_HIKARI_MAXIMUM_POOL_SIZE=50
FINERACT_HIKARI_IDLE_TIMEOUT=120000
FINERACT_HIKARI_CONNECTION_TIMEOUT=30000
FINERACT_HIKARI_TEST_QUERY=SELECT 1
FINERACT_HIKARI_AUTO_COMMIT=true
FINERACT_HIKARI_TRANSACTION_ISOLATION=TRANSACTION_REPEATABLE_READ

# ---- Tenant Configuration ----
FINERACT_DEFAULT_TENANTDB_HOSTNAME=db-primary
FINERACT_DEFAULT_TENANTDB_PORT=5432
FINERACT_DEFAULT_TENANTDB_UID=fineract
FINERACT_DEFAULT_TENANTDB_PWD=CHANGEME_USE_DOCKER_SECRETS
FINERACT_DEFAULT_TENANTDB_CONN_PARAMS=
FINERACT_DEFAULT_TENANTDB_IDENTIFIER=sea_default
FINERACT_DEFAULT_TENANTDB_NAME=fineract_default
FINERACT_DEFAULT_TENANTDB_DESCRIPTION=SEA Digital Banking Tenant
FINERACT_DEFAULT_MASTER_PASSWORD=fineract_prod

# ---- Security ----
FINERACT_SECURITY_BASICAUTH_ENABLED=true
FINERACT_SECURITY_OAUTH_ENABLED=true
FINERACT_SECURITY_2FA_ENABLED=true
FINERACT_SECURITY_HSTS_ENABLED=true
FINERACT_SECURITY_CORS_ENABLED=true
FINERACT_SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.your-domain.com

# ---- Caching ----
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_SPRING_EVENTS_ENABLED=true
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_ENABLED=true
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- External Events ----
FINERACT_EXTERNAL_EVENTS_ENABLED=true
FINERACT_EXTERNAL_EVENTS_KAFKA_ENABLED=true
FINERACT_EXTERNAL_EVENTS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FINERACT_EXTERNAL_EVENTS_PARTITION_SIZE=5000

# ---- Batch Processing ----
FINERACT_JOB_LOAN_COB_ENABLED=true
FINERACT_JOB_STUCK_RETRY_THRESHOLD=5
FINERACT_LOAN_COB_CHUNK_SIZE=100
FINERACT_LOAN_COB_PARTITION_SIZE=100
FINERACT_LOAN_COB_THREAD_POOL_CORE_POOL_SIZE=10
FINERACT_LOAN_COB_THREAD_POOL_MAX_POOL_SIZE=20

# ---- Monitoring & Observability ----
FINERACT_MANAGEMENT_ENDPOINT_WEB_EXPOSURE_INCLUDE=health,info,prometheus
FINERACT_MANAGEMENT_METRICS_TAGS_APPLICATION=fineract-sea
FINERACT_MANAGEMENT_PROMETHEUS_ENABLED=true
FINERACT_LOGGING_JSON_ENABLED=true
FINERACT_LOGGING_HTTP_CORRELATION_ID_ENABLED=true
FINERACT_CLIENT_IP_TRACKING_ENABLED=true

# ---- Content Management ----
FINERACT_CONTENT_FILESYSTEM_ENABLED=true
FINERACT_CONTENT_FILESYSTEM_ROOT_FOLDER=/var/data/fineract/content
FINERACT_CONTENT_S3_ENABLED=true
FINERACT_CONTENT_S3_BUCKET_NAME=fineract-sea-content
FINERACT_CONTENT_S3_REGION=ap-southeast-1

# ---- Java Runtime ----
JAVA_TOOL_OPTIONS=-Xmx3G -XX:MaxMetaspaceSize=512m -XX:+UseContainerSupport -XX:+UseG1GC -XX:+StringDeduplication
